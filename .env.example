# Industrial Effluent Monitoring System - Environment Configuration

# PostgreSQL Database
DATABASE_URL=postgresql://effluent_user:effluent_pass@localhost:5432/effluent_db
ASYNC_DATABASE_URL=postgresql+asyncpg://effluent_user:effluent_pass@localhost:5432/effluent_db

# JWT Secret & Expiry
SECRET_KEY=change_this_to_a_secure_random_secret_in_production_32_bytes_min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Gmail SMTP Alert Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
ENABLE_EMAIL_ALERTS=true
DEFAULT_CRITICAL_THRESHOLD=75.0

# Alert Notification Recipients (comma-separated list, e.g. user1@gmail.com,user2@gmail.com)
EMAIL_RECEIVERS=

# Monitored Facility Location
PLANT_LOCATION=Industrial Effluent Treatment Outfall - Monitoring Zone 1

# Groq AI API Key for Real-time Effluent Diagnostics & SCADA Copilot
GROQ_API_KEY=
