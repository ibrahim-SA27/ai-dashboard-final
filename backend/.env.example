# ==========================================
# Industrial Effluent Monitoring System
# Backend Environment Configuration
# ==========================================

# Application Settings
APP_NAME="Industrial Effluent Monitoring and Harmful Water Detection System"
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://*.run.app"]

# PostgreSQL Database
DATABASE_URL=postgresql://effluent_user:effluent_pass@localhost:5432/effluent_db
ASYNC_DATABASE_URL=postgresql+asyncpg://effluent_user:effluent_pass@localhost:5432/effluent_db

# JWT Authentication
SECRET_KEY=change_this_to_a_secure_random_secret_in_production_32_bytes_min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Gmail SMTP Alert Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
ENABLE_EMAIL_ALERTS=true
DEFAULT_CRITICAL_THRESHOLD=75.0

# Rate Limiting
RATE_LIMIT_DEFAULT=100/minute
